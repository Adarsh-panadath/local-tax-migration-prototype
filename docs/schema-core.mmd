erDiagram
  companies {
    text company_id PK
    text name
    integer migration_month
  }
  worksites {
    text company_id PK, FK
    text site_id PK
    text address_id FK
  }
  employees {
    text company_id PK, FK
    text employee_id PK
    text site_id FK
    real monthly_wages
  }
  employee_addresses {
    text company_id PK, FK
    text employee_id PK, FK
    integer from_month PK
    text address_id FK
  }
  addresses {
    text address_id PK
    text school_district
    text municipality
  }
  payroll_items {
    text company_id PK, FK
    text item_id PK
    text label
    text system_tax_id FK
  }
  desktop_lines {
    text company_id PK, FK
    text employee_id PK, FK
    text item_id PK, FK
  }
  taxes {
    text tax_id PK
    text type
    text code
    real rate
  }
  expected_taxes {
    text company_id PK, FK
    text employee_id PK, FK
    text tax_id PK, FK
    integer gap
  }
  line_results {
    text company_id PK, FK
    text employee_id PK, FK
    text item_id PK, FK
    text route
    text stage
    text decided_by
  }
  decisions {
    integer decision_id PK
    text company_id FK
    text employee_id FK
    text item_id FK
    text tax_id FK
    text decided_by
  }
  addresses ||--o{ worksites : "address_id"
  companies ||--o{ worksites : "company_id"
  worksites ||--o{ employees : "company_id, site_id"
  employees ||--o{ employee_addresses : "company_id, employee_id"
  addresses ||--o{ employee_addresses : "address_id"
  taxes ||--o{ payroll_items : "system_tax_id"
  companies ||--o{ payroll_items : "company_id"
  payroll_items ||--o{ desktop_lines : "company_id, item_id"
  employees ||--o{ desktop_lines : "company_id, employee_id"
  employees ||--o{ expected_taxes : "company_id, employee_id"
  taxes ||--o{ expected_taxes : "tax_id"
  desktop_lines ||--o| line_results : "company_id, employee_id, item_id"
  desktop_lines ||--o{ decisions : "company_id, employee_id, item_id"
  taxes ||--o{ decisions : "tax_id"
