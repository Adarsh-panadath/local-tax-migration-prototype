erDiagram
  company {
    text company_id PK
    text name
    integer migration_month
  }
  worksites {
    text site_id PK
    text name
    text address_id FK
  }
  employees {
    text employee_id PK
    text name
    text site_id FK
  }
  home_addresses {
    text employee_id PK, FK
    integer from_month PK
    text address_id FK
  }
  payroll_items {
    text item_id PK
    text label
    text system_tax_id FK
  }
  desktop_lines {
    text employee_id PK, FK
    text item_id PK, FK
  }
  addresses {
    text address_id PK
    text city
    text school_district
  }
  taxes {
    text tax_id PK
    text name
    real rate
  }
  expected_taxes {
    text employee_id PK, FK
    text tax_id PK, FK
    integer gap
  }
  line_results {
    text employee_id PK, FK
    text item_id PK, FK
    text route
    text decided_by
  }
  decision_log {
    integer log_id PK
    text who
    text action
  }
  addresses ||--o{ worksites : "address_id"
  worksites ||--o{ employees : "site_id"
  addresses ||--o{ home_addresses : "address_id"
  employees ||--o{ home_addresses : "employee_id"
  taxes ||--o{ payroll_items : "system_tax_id"
  payroll_items ||--o{ desktop_lines : "item_id"
  employees ||--o{ desktop_lines : "employee_id"
  taxes ||--o{ expected_taxes : "tax_id"
  employees ||--o{ expected_taxes : "employee_id"
  desktop_lines ||--o| line_results : "employee_id, item_id"
